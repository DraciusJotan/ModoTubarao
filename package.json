{
  "name": "sharkfit",
  "version": "1.0.0",
  "description": "Um site para acompanhar seus treinos de academia. Você registra o treino do dia e ele vira um mapa de calor de um ano inteiro, igual ao gráfico de contribuições do GitHub — quanto mais escuro o quadrado, mais pesado foi o treino.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:www": "node scripts/build-www.js",
    "cap:sync": "npm run build:www && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "assets": "capacitor-assets generate --assetPath resources --android --iconBackgroundColor \"#1a203b\" --iconBackgroundColorDark \"#1a203b\" --splashBackgroundColor \"#1a203b\" --splashBackgroundColorDark \"#1a203b\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DraciusJotan/ModoTubarao.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DraciusJotan/ModoTubarao/issues"
  },
  "homepage": "https://github.com/DraciusJotan/ModoTubarao#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
